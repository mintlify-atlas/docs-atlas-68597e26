  "keyFeatures": [
    "Auto-imports assignments from Canvas, Google Classroom, StudentVue, Schoology, Blackboard, and Moodle",
    "AI-generated weekly study schedules exported to Google Calendar",
    "Adaptive AI tutor (Plani) with student learning profiles, mastery tracking, and mistake detection",
    "Flashcard and quiz generation from uploaded notes (PDF, DOCX, TXT, images)",
    "Spaced repetition system (SRS) for active recall and mastery tracking",
    "Grade modeler to simulate 'what if I score X%?' scenarios",
    "Notion two-way task sync",
    "Push notifications for assignment deadline reminders",
    "Chrome Extension with badge count and Canvas/StudentVue page injection",
    "Progressive Web App (PWA) for Android and iOS",
    "Native desktop app for Windows, macOS, and Linux",
    "MCP server for AI assistant integrations (Claude Desktop, Cursor)",
    "Task-completion streak system with streak freezes and analytics",
    "Public REST API with scoped API keys for third-party integrations"
  ],
